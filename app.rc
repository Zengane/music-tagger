// Embedded in MusicTagger.exe so Explorer and the taskbar show the mark.
// The .ico itself is generated by `MusicTagger.exe --make-icon`, which draws
// it from the same geometry the window icon uses; see ui/logo.odin.
1 ICON "MusicTagger.ico"

// Who made this, for Explorer's properties panel and for Windows itself.
//
// An executable with no version block at all is one of the things Defender's
// machine-learning heuristics weigh, and this one was quarantined as
// Trojan:Win32/Wacatac.B!ml — its generic bucket. Version information does not
// fix that on its own; only a signature and a reputation do. It costs nothing
// and removes one reason to look suspicious, which is worth having for
// something meant to be handed to other people.
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x40004L   // VOS_NT_WINDOWS32
FILETYPE        0x1L       // VFT_APP
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904b0"   // US English, Unicode
        {
            VALUE "CompanyName",      "Zengane"
            VALUE "FileDescription",  "Music Tagger - browse, tag and audition a sound library"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MusicTagger"
            VALUE "OriginalFilename", "MusicTagger.exe"
            VALUE "ProductName",      "Music Tagger"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Zengane"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
